Screen {
    layout: vertical;
}

#stats {
    height: auto;
}

#main {
    height: 4fr;
    min-height: 10;
    layout: horizontal;
}

#results {
    width: 60%;
    min-width: 40;
    height: 1fr;
}

#vsplit {
    width: 1;
    height: 1fr;
}

#preview {
    width: 1fr;
    height: 1fr;
    border-left: solid $accent;
}

#logsplit {
    height: 1;
}

#logsplit.hidden {
    display: none;
}

#log {
    height: 1fr;
    min-height: 5;
    background: $surface;
}

#log.hidden {
    display: none;
}
