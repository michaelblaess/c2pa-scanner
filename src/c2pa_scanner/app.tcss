Screen {
    layout: vertical;
}

#stats {
    height: auto;
}

#main {
    height: 4fr;
    min-height: 10;
    layout: horizontal;
}

#results {
    width: 60%;
    min-width: 40;
    height: 1fr;
}

#vsplit {
    width: 1;
    height: 1fr;
}

#preview-col {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    border-left: solid $accent;
}

#preview {
    width: 1fr;
    height: 1fr;
}

#preview-split {
    height: 1;
}

#preview-split.hidden {
    display: none;
}

#page-preview {
    width: 1fr;
    height: 1fr;
    border-top: solid $accent;
}

#page-preview.hidden {
    display: none;
}

#logsplit {
    height: 1;
}

#logsplit.hidden {
    display: none;
}

#log {
    height: 1fr;
    min-height: 5;
    background: $surface;
}

#log.hidden {
    display: none;
}

/* Tasten, die gerade nicht gehen, ganz ausblenden statt nur auszugrauen.
   Textual vergibt .-disabled, sobald check_action None liefert - so steht
   'Scan abbrechen' nur waehrend eines Laufs im Fuss und 'Scannen' nur ausserhalb,
   statt beide dauerhaft nebeneinander zu zeigen. */
Footer FooterKey.-disabled {
    display: none;
}

/* Attention-Blink: der Timer schaltet .-attention an/aus (funktioniert auch auf
   Windows Terminal, wo ANSI text-style: blink ignoriert wird). */
Footer FooterKey.-attention .footer-key--key,
Footer FooterKey.-attention .footer-key--description {
    background: $accent;
    color: auto;
    text-style: bold;
}
